rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{sessionId} {
      function isMember() {
        return request.auth != null && exists(/databases/$(database)/documents/sessions/$(sessionId)/players/$(request.auth.uid));
      }

      allow read: if isMember();
      allow write: if false;

      match /players/{playerId} {
        allow read: if isMember();
        allow write: if false;

        match /scoreEntries/{entryId} {
          allow read: if isMember();
          allow write: if false;
        }
      }

      match /scoreReports/{reportId} {
        allow read: if isMember();
        allow write: if false;
      }

      match /scoreReportResolutions/{resolutionId} {
        allow read: if isMember();
        allow write: if false;
      }

      match /scoreCorrections/{correctionId} {
        allow read: if isMember();
        allow write: if false;
      }

      match /reopenEvents/{eventId} {
        allow read: if isMember();
        allow write: if false;
      }

      match /openScoreReports/{reportId} {
        allow read, write: if false;
      }
    }

    match /sessionCodes/{code} {
      allow read, write: if false;
    }

    match /sessionExpirations/{sessionId} {
      allow read, write: if false;
    }

    match /users/{userId}/sessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
